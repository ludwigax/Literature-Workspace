LITV2_ENV=development
# Optional public entry points when the local stack is exposed through FRP.
# Keep these three URLs consistent with the FRP remote port mappings.
LITV2_PUBLIC_APP_URL=http://127.0.0.1:5174
LITV2_PUBLIC_KEYCLOAK_URL=http://127.0.0.1:8081
LITV2_PUBLIC_S3_URL=http://127.0.0.1:9002
LITV2_BROWSER_ORIGIN_MAP={"http://127.0.0.1:5174":"http://127.0.0.1:8081","http://localhost:5174":"http://localhost:8081","http://127.0.0.1:8020":"http://127.0.0.1:8081","http://localhost:8020":"http://localhost:8081"}
LITV2_LOG_LEVEL=INFO
LITV2_DATABASE_URL=postgresql+psycopg://literature_app:literature-app-local@127.0.0.1:5433/literature_workspace
LITV2_MIGRATION_DATABASE_URL=postgresql+psycopg://literature:literature@127.0.0.1:5433/literature_workspace
LITV2_WORKER_DATABASE_URL=postgresql+psycopg://literature_worker:literature-worker-local@127.0.0.1:5433/literature_workspace
LITV2_CHAT_WORKER_DATABASE_URL=postgresql+psycopg://chat_worker:chat-worker-local@127.0.0.1:5433/literature_workspace
LITV2_OIDC_ISSUER=http://127.0.0.1:8081/realms/literature-v2
LITV2_OIDC_DISCOVERY_URL=http://127.0.0.1:8081/realms/literature-v2/.well-known/openid-configuration
LITV2_OIDC_CLIENT_ID=literature-v2-web
LITV2_OIDC_CLIENT_SECRET=local-development-only
LITV2_OIDC_SIGNING_ALGORITHMS=RS256
LITV2_OIDC_BACKEND_BASE_URL=http://127.0.0.1:8081
LITV2_PUBLIC_API_BASE_URL=http://127.0.0.1:8020
LITV2_FRONTEND_URL=http://127.0.0.1:5174
LITV2_SESSION_SECRET=replace-with-at-least-32-random-characters
LITV2_BOOTSTRAP_ADMIN_EMAILS=alice@example.test
LITV2_CHAT_PROVIDER=fake
LITV2_CHAT_MODEL=fake-chat-model
LITV2_CHAT_OPENAI_API_KEY=
LITV2_CHAT_OPENAI_BASE_URL=
LITV2_CHAT_WORKER_MAX_CONCURRENCY=32
LITV2_CHAT_PRINCIPAL_MAX_CONCURRENCY=3
LITV2_CHAT_MAX_TOOL_CALLS_CEILING=100
LITV2_CHAT_RETRIEVAL_MODE=HYBRID
LITV2_CHAT_RETRIEVAL_TOP_K=20
LITV2_CHAT_CHUNK_TOP_K_PER_DOCUMENT=5
LITV2_CHAT_DOI_DOCUMENT_MAX_CHARS=20000
LITV2_S3_ENDPOINT_URL=http://127.0.0.1:9002
LITV2_S3_PUBLIC_ENDPOINT_URL=http://127.0.0.1:9002
LITV2_S3_ACCESS_KEY=literature
LITV2_S3_SECRET_KEY=literature-local-secret
LITV2_S3_BUCKET=literature-v2
LITV2_S3_REGION=us-east-1
LITV2_CROSSREF_BASE_URL=https://api.crossref.org
LITV2_OPENALEX_BASE_URL=https://api.openalex.org
LITV2_METADATA_PROVIDER_TIMEOUT_SECONDS=15
LITV2_SCHOLARLY_API_MAILTO=
LITV2_WORKER_CONCURRENCY=4
LITV2_CITATION_IMPORT_MAX_BYTES=10485760
LITV2_FAKE_PDF_TEXT_LATENCY_SECONDS=60
LITV2_FAKE_PDF_TEXT_WORD_COUNT=500
LITV2_EMBEDDING_BASE_URL=http://223.109.141.102:6012/v1
LITV2_EMBEDDING_API_KEY=
LITV2_EMBEDDING_MODEL=bge-m3
LITV2_EMBEDDING_DIMENSIONS=1024
LITV2_EMBEDDING_BATCH_SIZE=32
LITV2_EMBEDDING_MAX_BATCH_TOKENS=10000
LITV2_EMBEDDING_TIMEOUT_SECONDS=60
LITV2_EMBEDDING_MAX_RETRIES=2
LITV2_DOCUMENT_PDF_TEXT_URL=http://127.0.0.1:8023
LITV2_DOCUMENT_PDF_TEXT_REQUEST_TIMEOUT_SECONDS=60
LITV2_DOCUMENT_PDF_TEXT_JOB_TIMEOUT_SECONDS=3600
LITV2_DOCUMENT_PDF_TEXT_POLL_INTERVAL_SECONDS=2
LITV2_DOCUMENT_PIPELINE_URL=
LITV2_DOCUMENT_SOURCE_CONCURRENCY=1
LITV2_DOCUMENT_PIPELINE_CONCURRENCY=4
LITV2_DOCUMENT_INDEX_CONCURRENCY=1
LITV2_DOCUMENT_TASK_LEASE_SECONDS=3900
LITV2_DOCUMENT_SCHEDULER_POLL_SECONDS=60
