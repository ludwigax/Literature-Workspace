CHATV2_ENV=development
CHATV2_DATABASE_URL=postgresql+psycopg://chat_app:chat-app-local@127.0.0.1:5434/chat_v2
CHATV2_MIGRATION_DATABASE_URL=postgresql+psycopg://chat:chat@127.0.0.1:5434/chat_v2
CHATV2_WORKER_DATABASE_URL=postgresql+psycopg://chat_worker:chat-worker-local@127.0.0.1:5434/chat_v2
CHATV2_ALLOW_DEVELOPMENT_ACTOR_HEADER=true
CHATV2_PROVIDER=fake
CHATV2_MODEL=fake-chat-model
# To use the real provider, set provider=openai, choose a Responses model, and
# provide CHATV2_OPENAI_API_KEY (or the conventional OPENAI_API_KEY).
# CHATV2_PROVIDER=openai
# CHATV2_MODEL=gpt-5.4
# CHATV2_OPENAI_API_KEY=
# CHATV2_OPENAI_BASE_URL=
CHATV2_FAKE_RESPONSE_PREFIX=Fake response
CHATV2_FAKE_STREAM_DELAY_SECONDS=0
CHATV2_WORKER_POLL_SECONDS=0.25
CHATV2_TURN_LEASE_SECONDS=120
CHATV2_WORKER_MAX_CONCURRENCY=32
CHATV2_PRINCIPAL_MAX_CONCURRENCY=3
CHATV2_LITERATURE_API_BASE_URL=http://127.0.0.1:8020/api/v2
CHATV2_LITERATURE_API_TIMEOUT_SECONDS=60
CHATV2_LITERATURE_SERVICE_TOKEN=replace-with-a-random-chat-service-token
CHATV2_LITERATURE_RETRIEVAL_MODE=HYBRID
CHATV2_LITERATURE_RETRIEVAL_TOP_K=20
CHATV2_LITERATURE_CHUNK_TOP_K_PER_DOCUMENT=5
CHATV2_LITERATURE_DOI_DOCUMENT_MAX_CHARS=20000
CHATV2_SSE_POLL_SECONDS=0.25
CHATV2_SSE_HEARTBEAT_SECONDS=15
